{
  "name": "growth-frameworks",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable, company-agnostic growth engineering frameworks",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/connectors/*",
    "packages/frameworks/*",
    "packages/storage/*"
  ],
  "scripts": {
    "dry-run:competitive-footprint": "node apps/cli/src/competitive-footprint-dry-run.ts",
    "deliver:competitive-footprint": "node apps/cli/src/competitive-footprint-delivery.ts",
    "preflight:competitive-footprint": "node apps/cli/src/competitive-footprint-preflight.ts",
    "scan:competitive-footprint": "node apps/cli/src/competitive-footprint-network-dry-run.ts",
    "scan:competitive-footprint:hubspot": "node apps/cli/src/competitive-footprint-hubspot-dry-run.ts",
    "canary:competitive-footprint:hubspot": "node apps/cli/src/competitive-footprint-hubspot-canary.ts",
    "canary:competitive-footprint:probes": "node apps/cli/src/competitive-footprint-probe-canary.ts",
    "test": "node --test",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
